{
 "uid": "floe",
 "title": "floe: streaming lakehouse",
 "tags": [
  "floe",
  "iceberg",
  "kafka"
 ],
 "timezone": "browser",
 "refresh": "5s",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Events committed / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(floe_rows_committed_total{table=\"bronze.wiki_edits\"}[1m]))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "custom": {},
     "unit": "ops",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#00e5ff",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Consumer lag (msgs)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
