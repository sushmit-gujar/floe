     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(floe_consumer_lag) or vector(0)",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
